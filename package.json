{
  "name": "arda.tr",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "packageManager": "npm@11.9.0",
  "engines": {
    "node": "24.x",
    "npm": "11.x"
  },
  "scripts": {
    "generate:site-config": "node scripts/generate-site-config-module.mjs",
    "generate:themes-contract": "node scripts/generate-themes-contract.mjs",
    "theme:build": "astryx experimental theme compile themes/arda/arda.theme.ts && npm run generate:themes-contract",
    "res:build": "npm run generate:site-config && npm run generate:themes-contract && rescript",
    "res:clean": "rescript clean",
    "res:dev": "rescript -w",
    "dev": "npm run generate:site-config && npm run generate:themes-contract && concurrently -k -n rescript,vite \"npm run res:dev\" \"vite --config config/vite.config.ts\"",
    "build": "npm run res:build && vite build --config config/vite.config.ts && npm run prerender && npm run generate:sitemap",
    "prerender": "node scripts/prerender.mjs",
    "generate:sitemap": "node scripts/generate-sitemap.mjs",
    "lint": "eslint src config scripts --config config/eslint.config.js",
    "typecheck": "tsc -b tsconfig.json",
    "test": "vitest run --config config/vitest.config.ts",
    "verify": "npm run lint && npm run typecheck && npm run test",
    "preview": "vite preview --config config/vite.config.ts",
    "prepare": "npm run res:build"
  },
  "dependencies": {
    "@astryxdesign/core": "0.7.17",
    "@astryxdesign/theme-neutral": "0.7.17",
    "@rescript/core": "^1.6.1",
    "@rescript/react": "^0.14.2",
    "@stylexjs/stylex": "^0.19.2",
    "react": "^19.3.1",
    "react-dom": "^19.3.1"
  },
  "devDependencies": {
    "@astryxdesign/cli": "0.7.17",
    "@eslint/js": "^9.39.4",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.0",
    "@types/node": "^24.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.0.1",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.4",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^17.4.0",
    "jsdom": "^27.0.1",
    "rescript": "^12.0.0",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.57.2",
    "vite": "^8.0.3",
    "vitest": "^3.2.4"
  }
}
