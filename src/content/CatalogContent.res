/* The catalogue. One table, many kinds — a Kubernetes migration and a black
   metal record are the same kind of object here, distinguished only by band.

   `band` maps to the IEC 60062 resistor colour code (see DESIGN.md). It is the
   only thing colour encodes in this system. Every band is paired with its kind
   name in the markup so colour is never the sole signal. */

type kind = {
  band: int,
  name: string,
  note: string,
}

type entry = {
  cat: string,
  band: int,
  name: string,
  description: string,
  spec: string,
  year: string,
  status: string,
  href: string,
  repo: string,
  image: string,
  featured: bool,
  containImage: bool,
  invertOnLight: bool,
}

let catalogueNo = "No.1"
let revision = "2026.09"

let kinds: array<kind> = [
  {band: 1, name: "Systems", note: "infrastructure & architecture"},
  {band: 2, name: "Products", note: "shipped applications"},
  {band: 3, name: "Games", note: "originals & ports"},
  {band: 4, name: "Writing", note: "essays & notes"},
  {band: 5, name: "Tools", note: "open source utilities"},
  {band: 6, name: "Recorded", note: "released music"},
  {band: 7, name: "Composed", note: "generated & written music"},
]

