/* The catalogue. One table, many kinds — a Kubernetes migration and a black
   metal record are the same kind of object here, distinguished only by band.

   `band` is the entry's kind (see `kinds`): the kind filter and each row's
   kind code read it. `cat` is the catalogue number, kept as the entry's
   anchor id; the three-digit number shown is the entry's place in the list. */

type kind = {
  band: int,
  // The three-or-four-letter code shown in a row's kind column.
  code: string,
  name: string,
  note: string,
}

type entry = {
  cat: string,
  band: int,
  name: string,
  description: string,
  status: string,
  href: string,
  repo: string,
  image: string,
  featured: bool,
}

let kinds: array<kind> = [
  {band: 1, code: "SYS", name: "Systems", note: "cloud infrastructure and architecture"},
  {band: 2, code: "APP", name: "Products", note: "shipped apps and web projects"},
  {band: 3, code: "GAME", name: "Games", note: "original games and ports"},
  {band: 4, code: "POST", name: "Writing", note: "technical essays and notes"},
  {band: 5, code: "TOOL", name: "Tools", note: "open-source utilities and tools"},
  {band: 6, code: "REC", name: "Recorded", note: "recorded releases"},
  {band: 7, code: "COMP", name: "Composed", note: "written and generated music"},
]

