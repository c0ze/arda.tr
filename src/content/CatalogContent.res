/* The works, under five categories. A category is a block that opens on the
   page (Works.res); its entries are listed inside it.

   `category` is the id of the entry's category (see `categories`). `group`,
   when set, gathers entries into one line under that label (coze's games).
   `cat` is the catalogue number, kept as the entry's anchor id so old deep
   links (#AK-2-0142) still land. */

type category = {
  id: string,
  name: string,
  // What the closed block says it holds.
  note: string,
}

type entry = {
  cat: string,
  category: string,
  group: string,
  name: string,
  description: string,
  status: string,
  href: string,
  repo: string,
  image: string,
  featured: bool,
}

let categories: array<category> = [
  {id: "coze", name: "coze", note: "dergi, RETRO, games"},
  {id: "gand", name: "gand", note: "Skrivist, Vigil Today, SUDONE"},
  {id: "gand-games", name: "gand.games", note: "the games studio"},
  {id: "music", name: "music", note: "Pagan, The Seventh Shadow, cozy-studio"},
  {id: "github", name: "github", note: "selected open source"},
]

