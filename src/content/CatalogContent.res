let kindFor = band =>
  switch kinds->Array.find(k => k.band == band) {
  | Some(k) => k
  | None => {band, name: "Archive", note: "retired"}
  }

let countFor = band => entries->Array.filter(e => e.band == band)->Array.length

let featured = entries->Array.filter(e => e.featured)
